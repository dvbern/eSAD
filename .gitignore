### Project specific ignores ###

# Place .gitignore settings specific to your project here


##### Common ignore settings ####

## Local developer / local build settings
developer-local-settings/
build.properties
.env
# local e2e users, generated by frontend/apps/esc-app-e2e/scripts/provision-local-users.mjs
e2e.env
docker-compose.override.yml

### Build systems ###

## Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

## Gradle
/local.properties
.gradle/

## Node.js / NPM
node_modules/
debug.log
npm-debug.log

## Generic build output directories
dist/
build/


### Editors & IDEs ###

## IntelliJ
*.iml
*.iws
.idea/
# IntelliJ creates this directory in WAR-modules with WAR-dependencies
overlays/

## Eclipse
.metadata
.settings/
.loadpath
.project
.classpath
.externalToolBuilders/

## Netbeans
nbproject/

## Sublime
*.sublime-workspace

## Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json


### Misc ###

## System Files
.DS_Store
Thumbs.db

## JVM
# Fatal Error logs
hs_err_pid*.log
# Remote Debugger temp files
.attach_pid*


## Patches
*.orig
*.rej

## Files, that should never be ignored
!**/.gitkeep
!**/.gitignore
!**/.gitattributes
!**/.editorconfig

## Personal files
/api/docs/escada-service/prepared-escada-curl-request.ps1
/api/docs/escada-service/prepared-escada-curl-request.sh
/api/docs/escada-service/prepared-escada-curl-request-dev.ps1
/api/docs/escada-service/prepared-escada-curl-request-dev.sh
/api/docs/escada-service/escada-client.json
/frontend/playwright/.auth/*
/.run/
/api/docs/escada-service/scripts/
/api/docs/file-ingress/scripts/
/api/docs/pupil-service/scripts/
/api/.vfox
/frontend/.vfox
