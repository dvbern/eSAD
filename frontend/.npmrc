# Force DV Bern NPM Registry
registry = https://nexus.dvbern.ch/nexus/content/groups/npm-all/
# Sicherstellen, dass neue Pakete eine gewisse "Reife" haben. Erhöht den Schutz etwas, da in der Zwischenzeit hoffentlich schon diverse Security Tools verdächtige Aktionen bemerkt haben.
min-release-age = 7

# postinstall Skripte nicht ausführen. AFAIK ist das in der gitlab nx component bereits über ein CLI Argument aktiv, aber wir sollten auch die Systeme von Devs schützen.
ignore-scripts = true

# dependencies von git repos verbieten
allow-git = none
