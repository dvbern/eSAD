{
  http_port 8080
  https_port 8443
}

:8080 {
        # Serve Public Application under /publicapp/
        handle_path /publicapp/* {
                root * /srv/app_public
                try_files {path} /index.html
                file_server
        }

        # Main Application (fallback)
        handle {
                root * /srv/app
                try_files {path} /index.html
                file_server
        }

        log {
          format console
        }

        respond /_health 200

        # Security Headers on all paths
        header {
                # disable FLoC tracking
                Permissions-Policy interest-cohort=()

                # enable HSTS
                Strict-Transport-Security max-age=31536000;

                # disable clients from sniffing the media type
                X-Content-Type-Options nosniff

                # clickjacking protection
                X-Frame-Options DENY

                X-Xss-Protection "1; mode=block"

                # keep referrer data off of HTTP connections
                Referrer-Policy no-referrer-when-downgrade
        }

        # File upload & timeouts
        header {
                Upload-Max "21m"
                Upload-Timeout "300s"
        }

        # Content Security Policy (CSP)
        header {
                Content-Security-Policy "
            default-src 'self';
            style-src 'self' 'unsafe-inline';
            script-src 'self' 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc=';
            font-src 'self';
            img-src 'self' data: blob:;
            form-action 'self';
            connect-src 'self' data: *.dvbern.ch;
            frame-src 'self' *.dvbern.ch;
            frame-ancestors 'self' {$ADDITIONAL_FRAME_ANCESTORS};
            report-uri {$CSP_REPORT_URI};
        "
        }

        @assets {
          path *.js
          path *.css
          path assets/images
        }

        header @assets Cache-Control public,max-age=31536000,immutable

        encode zstd gzip
}
