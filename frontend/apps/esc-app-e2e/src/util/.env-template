# Users for the SHARED DV Bern environment. Copy to .env and fill in.
#
# For the LOCAL docker-compose stack, generate e2e.env instead (it takes precedence over .env):
#   cd frontend && node apps/esc-app-e2e/scripts/provision-local-users.mjs --tenants bs,be
# It creates the users in the local Keycloak and writes their credentials; --fix-realms adds what a realm
# lacks (BE has no OAuth2Proxy client out of the box). Pick the tenant per run with E2E_TENANT=bs|be.

#Users
ESC_ADMIN_USER=escadmin@mailbucket.dvbern.ch
ESC_ADMIN_PASSWORD=CHANGEME

ESC_EMPFANG_USER=escempfang@mailbucket.dvbern.ch
ESC_EMPFANG_PASSWORD=CHANGEME

ESC_MPA_USER=escmpa@mailbucket.dvbern.ch
ESC_MPA_PASSWORD=CHANGEME

ESC_ORTHOPISTIN_USER=escorthopistin@mailbucket.dvbern.ch
ESC_ORTHOPISTIN_PASSWORD=CHANGEME

ESC_SCHULAERZTIN_USER=escschulaerztin@mailbucket.dvbern.ch
ESC_SCHULAERZTIN_PASSWORD=CHANGEME

ESC_SUPERMPA_USER=escsupermpa@mailbucket.dvbern.ch
ESC_SUPERMPA_PASSWORD=CHANGEME

ESC_SUPPORT_USER=escsupport@mailbucket.dvbern.ch
ESC_SUPPORT_PASSWORD=CHANGEME

#Global Settings
BASE_URL=CHANGEME
