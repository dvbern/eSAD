{
  "name": "esc-info-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/esc-info-app/src",
  "tags": ["scope:esc-info-app", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/esc-info-app",
        "baseHref": "/publicapp/",
        "browser": "apps/esc-info-app/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/esc-info-app/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/esc-info-app/public"
          },
          {
            "glob": "**/*",
            "input": "libs/shared/ui/ui-components/src/assets/fonts",
            "output": "fonts"
          },
          {
            "glob": "**/*",
            "input": "libs/shared/ui/ui-components/src/assets/img",
            "output": "img"
          },
          {
            "glob": "**/*",
            "input": "libs/shared/ui/ui-components/src/assets/icons",
            "output": "icons"
          }
        ],
        "styles": ["apps/esc-info-app/src/styles.scss",
          {
            "input": "libs/shared/ui/ui-components/src/styles/viz-styles.scss",
            "inject": false,
            "bundleName": "viz-styles"
          }
        ],
        "scripts": [],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/shared/ui/ui-components/src"]
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "options": {
        "host": "local-esc-bs.localhost",
        "port": 4300,
        "proxyConfig": "apps/esc-info-app/proxy.conf.bs.json",
        "headers": {
          "Content-Security-Policy": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc='; font-src 'self'; img-src 'self' data: blob:; form-action 'self'; connect-src 'self' data: *.dvbern.ch; frame-src 'self' *.dvbern.ch; "
        },
        "ssl": true,
        "sslCert": "../developer-local-settings/config/certs/local-esc-bs.localhost.pem",
        "sslKey": "../developer-local-settings/config/certs/local-esc-bs.localhost.key"
      },
      "configurations": {
        "production": {
          "buildTarget": "esc-info-app:build:production"
        },
        "development": {
          "buildTarget": "esc-info-app:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "serve-bs": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "options": {
        "host": "local-esc-bs.localhost",
        "port": 4300,
        "proxyConfig": "apps/esc-info-app/proxy.conf.bs.json",
        "headers": {
          "Content-Security-Policy": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc='; font-src 'self'; img-src 'self' data: blob:; form-action 'self'; connect-src 'self' data: *.dvbern.ch; frame-src 'self' *.dvbern.ch; "
        },
        "ssl": true,
        "sslCert": "../developer-local-settings/config/certs/local-esc-bs.localhost.pem",
        "sslKey": "../developer-local-settings/config/certs/local-esc-bs.localhost.key"
      },
      "configurations": {
        "production": {
          "buildTarget": "esc-info-app:build:production"
        },
        "development": {
          "buildTarget": "esc-info-app:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "serve-be": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "options": {
        "host": "local-esc-be.localhost",
        "port": 4301,
        "proxyConfig": "apps/esc-info-app/proxy.conf.be.json",
        "headers": {
          "Content-Security-Policy": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc='; font-src 'self'; img-src 'self' data: blob:; form-action 'self'; connect-src 'self' data: *.dvbern.ch; frame-src 'self' *.dvbern.ch; "
        },
        "ssl": true,
        "sslCert": "../developer-local-settings/config/certs/local-esc-be.localhost.pem",
        "sslKey": "../developer-local-settings/config/certs/local-esc-be.localhost.key"
      },
      "configurations": {
        "production": {
          "buildTarget": "esc-info-app:build:production"
        },
        "development": {
          "buildTarget": "esc-info-app:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "serve-win": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "options": {
        "host": "local-esc-win.localhost",
        "port": 4302,
        "proxyConfig": "apps/esc-info-app/proxy.conf.win.json",
        "headers": {
          "Content-Security-Policy": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc='; font-src 'self'; img-src 'self' data: blob:; form-action 'self'; connect-src 'self' data: *.dvbern.ch; frame-src 'self' *.dvbern.ch; "
        },
        "ssl": true,
        "sslCert": "../developer-local-settings/config/certs/local-esc-win.localhost.pem",
        "sslKey": "../developer-local-settings/config/certs/local-esc-win.localhost.key"
      },
      "configurations": {
        "production": {
          "buildTarget": "esc-info-app:build:production"
        },
        "development": {
          "buildTarget": "esc-info-app:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "esc-info-app:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/esc-info-app/jest.config.ts",
        "tsConfig": "apps/esc-info-app/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "esc-info-app:build",
        "port": 4200,
        "staticFilePath": "dist/apps/esc-info-app/browser",
        "spa": true
      }
    }
  }
}
