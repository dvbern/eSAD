{
  "name": "esc-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/esc-app/src",
  "tags": [
    "scope:esc-app"
  ],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/esc-app",
        "index": "apps/esc-app/src/index.html",
        "browser": "apps/esc-app/src/main.ts",
        "polyfills": [
          "@angular/localize/init"
        ],
        "tsConfig": "apps/esc-app/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/esc-app/src/assets",
            "output": "assets"
          },
          {
            "glob": "**/*",
            "input": "apps/esc-app/public"
          },
          {
            "glob": "**/*",
            "input": "libs/shared/feat/feat-auth-keycloak/assets",
            "output": "assets"
          },
          {
            "glob": "**/*",
            "input": "libs/shared/ui/ui-components/src/assets/img",
            "output": "img"
          },
          {
            "glob": "**/*",
            "input": "libs/shared/ui/ui-components/src/assets/icons",
            "output": "icons"
          }
        ],
        "styles": [
          "apps/esc-app/src/styles.scss",
          {
            "input": "libs/shared/ui/ui-components/src/styles/viz-styles.scss",
            "inject": false,
            "bundleName": "viz-styles"
          }
        ],
        "scripts": [],
        "stylePreprocessorOptions": {
          "includePaths": [
            "libs/shared/ui/ui-components/src"
          ]
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1.4mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "200kb"
            }
          ],
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            },
            "fonts": true
          },
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "options": {
        "host": "local-esc-bs.localhost",
        "port": 4200,
        "headers": {
          "Content-Security-Policy": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; img-src 'self' data: blob:; form-action 'self'; connect-src 'self' data: *.dvbern.ch; frame-src 'self' *.dvbern.ch; "
        },
        "ssl": true,
        "sslCert": "../developer-local-settings/config/certs/local-esc-bs.localhost.pem",
        "sslKey": "../developer-local-settings/config/certs/local-esc-bs.localhost.key"
      },
      "configurations": {
        "production": {
          "buildTarget": "esc-app:build:production"
        },
        "development": {
          "buildTarget": "esc-app:build:development"
        }
      },
      "defaultConfiguration": "development",
      "continuous": true
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "esc-app:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "esc-app:build",
        "port": 4200,
        "staticFilePath": "dist/apps/esc-app/browser",
        "spa": true
      }
    }
  }
}
