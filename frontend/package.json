    "@angular/platform-browser-dynamic": "20.2.4",
    "@angular/router": "20.2.4",
    "@jsverse/transloco": "^7.6.1",
    "@ng-bootstrap/ng-bootstrap": "19.0.1",
    "@ng-icons/bootstrap-icons": "^29.5.2",
    "@ng-icons/core": "^29.5.2",
    "@ng-icons/font-awesome": "^29.5.2",
    "@ng-icons/heroicons": "^29.5.2",
    "@ng-select/ng-select": "^20.7.0",
    "@ngrx/effects": "^20.0.1",
    "@ngrx/operators": "^20.0.1",
    "@ngrx/signals": "^20.0.1",
    "@popperjs/core": "^2.11.8",
    "@sentry/angular": "^9.9.0",
    "@types/d3": "^7.4.3",
    "@types/prompts": "^2.4.9",
    "angularx-qrcode": "^20.0.0",
    "bootstrap": "^5.3.3",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "immer": "^10.1.1",
    "ngx-file-drop": "^16.0.0",
    "normalizr": "^3.6.2",
    "rxjs": "~7.8.0",
    "thenby": "^1.3.4",
    "zone.js": "0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.2.2",
    "@angular-devkit/core": "20.2.2",
    "@angular-devkit/schematics": "20.2.2",
    "@angular/cli": "~20.2.0",
