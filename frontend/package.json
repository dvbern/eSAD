    "@eslint/js": "^9.8.0",
    "@lukemorales/jest-type-matchers": "^0.2.2",
    "@nx/angular": "21.5.2",
    "@nx/devkit": "21.5.2",
    "@nx/eslint": "21.5.2",
    "@nx/eslint-plugin": "21.5.2",
    "@nx/jest": "21.5.2",
    "@nx/js": "21.5.2",
