{
  "name": "@dvb/angular-starter",
  "version": "26.12.0-SNAPSHOT",
  "license": "FIXME: starter: determine license",
  "scripts": {
    "prepush": "run-s prepush:*",
    "prepush:format": "echo FIXME not yet implemented npm run format:test",
    "prepush:sort-translations": "run-s translations:normalize",
    "prepush:lint": "npm run lint",
    "prepush:test": "npm run test",
    "prepush:build": "nx run-many --target=build --configuration=production",
    "prepush:storybook": "echo FIXME not yet implemented concurrently -k -s first \"npm run storybook:ci\" \"npm run storybook:test\"",
    "prebuild": "check-engine",
    "build": "nx run-many --target=build --configuration=production",
    "prebuild:affected": "check-engine",
    "build:affected": "nx affected:build --configuration=production",
    "clean": "run-p -n clean:*",
    "clean:files": "rimraf .angular dist tmp coverage",
    "clean:nx": "nx reset",
    "reset": "nx reset",
    "format": "nx format:write",
    "format:affected": "nx affected:format",
    "translations:normalize": "tsx scripts/normalize-json.ts \"de|fr\"",
    "g:lib": "npx nx g @dvb/nx-plugin:lib",
    "g:lib:dry": "npx nx g @dvb/nx-plugin:lib --dry-run",
    "g:store-with-entities": "npx nx g @dvb/nx-plugin:store-with-entities",
    "g:store-with-entities:dry": "npx nx g @dvb/nx-plugin:store-with-entities --dry-run",
    "g:store-simple": "npx nx g @dvb/nx-plugin:store-simple",
    "g:store-simple:dry": "npx nx g @dvb/nx-plugin:store-simple --dry-run",
    "graph": "nx graph",
    "prelint": "check-engine",
    "typecheck": "tsc --noEmit -p apps/esc-app/tsconfig.app.json",
    "lint": "nx run-many --target=lint --all",
    "lint:fix": "nx run-many --target=lint --all --fix",
    "prelint:affected": "check-engine",
    "lint:affected": "nx affected:lint",
    "start": "nx serve --host 0.0.0.0",
    "startinfo:bs": "npm run serve:esc-info-app:bs",
    "startinfo:be": "npm run serve:esc-info-app:be",
    "startinfo:win": "npm run serve:esc-info-app:win",
    "preserve": "check-engine",
    "serve": "nx serve --host 0.0.0.0",
    "preserve:esc-app": "check-engine",
    "serve:esc-app": "nx serve esc-app",
    "serve:esc-info-app:bs": "nx run esc-info-app:serve-bs",
    "serve:esc-info-app:be": "nx run esc-info-app:serve-be",
    "serve:esc-info-app:win": "nx run esc-info-app:serve-win",
    "pretest": "check-engine",
    "test": "nx run-many --target=test --runInBand",
    "pretest:affected": "check-engine",
    "test:affected": "nx affected:test",
    "preopenapi": "check-engine",
    "openapi": "tsx scripts/openapi-build.ts",
    "openapi:version-manager": "openapi-generator-cli version-manager",
    "openapi:extract-current-templates": "openapi-generator-cli author template -g typescript-angular -o scripts/conf/openapi-templates/default",
    "playwright-report": "npx playwright show-report",
    "playwright-ui": "npx playwright test --ui",
    "playwright-ui:esc-e2e": "npm run playwright-ui -- --config=apps/esc-app-e2e/playwright.ui.config.ts",
    "playwright:esc-e2e": "RUN_ID=$(date +%Y%m%d%H%M) npx playwright test --config=apps/esc-app-e2e/playwright.config.ts"
  },
  "private": true,
  "dependencies": {
    "@angular-architects/ngrx-toolkit": "^21.0.1",
    "@angular/animations": "21.2.18",
    "@angular/common": "21.2.18",
    "@angular/compiler": "21.2.18",
    "@angular/core": "21.2.18",
    "@angular/forms": "21.2.18",
    "@angular/localize": "21.2.18",
    "@angular/platform-browser": "21.2.18",
    "@angular/platform-browser-dynamic": "21.2.18",
    "@angular/router": "21.2.18",
    "@jsverse/transloco": "^7.6.1",
    "@ng-bootstrap/ng-bootstrap": "20.0.0",
    "@ng-icons/bootstrap-icons": "^29.5.2",
    "@ng-icons/core": "^29.5.2",
    "@ng-icons/font-awesome": "^29.5.2",
    "@ng-icons/heroicons": "^29.5.2",
    "@ng-select/ng-select": "^21.8.2",
    "@ngrx/effects": "^21.1.0",
    "@ngrx/operators": "^21.1.0",
    "@ngrx/signals": "^21.1.0",
    "@popperjs/core": "^2.11.8",
    "@sentry/angular": "^10.52.0",
    "@types/d3": "^7.4.3",
    "@types/prompts": "^2.4.9",
    "angularx-qrcode": "^21.0.5",
    "bootstrap": "^5.3.3",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "immer": "^10.1.1",
    "ngx-file-drop": "^16.0.0",
    "normalizr": "^3.6.2",
    "rxjs": "~7.8.0",
    "thenby": "^1.3.4",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.19",
    "@angular-devkit/core": "21.2.19",
    "@angular-devkit/schematics": "21.2.19",
    "@angular/build": "21.2.19",
    "@angular/cli": "21.2.19",
    "@angular/compiler-cli": "21.2.18",
    "@angular/language-service": "21.2.18",
    "@eslint/js": "^9.8.0",
    "@lukemorales/jest-type-matchers": "^0.2.2",
    "@nx/angular": "22.7.7",
    "@nx/devkit": "22.7.7",
    "@nx/eslint": "22.7.7",
    "@nx/eslint-plugin": "22.7.7",
    "@nx/jest": "22.7.7",
    "@nx/js": "22.7.7",
    "@nx/playwright": "22.7.7",
    "@nx/shared-fs-cache": "^5.0.5",
    "@nx/web": "22.7.7",
    "@nx/workspace": "22.7.7",
    "@openapitools/openapi-generator-cli": "^2.18.4",
    "@playwright/test": "^1.51.1",
    "@schematics/angular": "21.2.19",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.33",
    "@swc/helpers": "0.5.21",
    "@testing-library/angular": "17.3.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "30.0.0",
    "@types/node": "18.16.9",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@typescript-eslint/utils": "^8.40.0",
    "angular-eslint": "21.3.1",
    "autoprefixer": "^10.4.0",
    "baseline-browser-mapping": "^2.8.32",
    "check-engine": "^1.14.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "^1.6.2",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-preset-angular": "16.0.0",
    "jest-util": "30.4.1",
    "jsonc-eslint-parser": "^2.1.0",
    "ng-packagr": "21.2.3",
    "npm-run-all": "^4.1.5",
    "nx": "22.7.7",
    "postcss": "^8.4.5",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.9",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "tsx": "^4.19.3",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.33.1"
  },
  "overrides": {
    "axios": "^1.16.0"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0 <12.0.0"
  }
}
