      "@dvb/feat-app-mode-selection": ["libs/esc-app/feat/feat-app-mode-selection/src/index.ts"],
      "@dvb/feat-aufgaben": ["libs/esc-app/feat/feat-aufgaben/src/index.ts"],
      "@dvb/feat-auth-keycloak": ["libs/shared/feat/feat-auth-keycloak/src/index.ts"],
      "@dvb/feat-config": ["libs/esc-app/feat/feat-config/src/index.ts"],
      "@dvb/feat-core": ["libs/shared/feat/feat-core/src/index.ts"],
      "@dvb/feat-dashboard": ["libs/esc-app/feat/feat-dashboard/src/index.ts"],
      "@dvb/feat-deployment": ["libs/shared/feat/feat-deployment/src/index.ts"],
      "@dvb/feat-dialogs": ["libs/shared/feat/feat-dialogs/src/index.ts"],
      "@dvb/feat-document-queue": ["libs/shared/feat/feat-document-queue/src/index.ts"],
      "@dvb/feat-kinder": ["libs/esc-app/feat/feat-kinder/src/index.ts"],
      "@dvb/feat-notifications": ["libs/shared/feat/feat-notifications/src/index.ts"],
      "@dvb/feat-notizen": ["libs/esc-app/feat/feat-notizen/src/index.ts"],
      "@dvb/feat-page": ["libs/shared/feat/feat-page/src/index.ts"],
      "@dvb/feat-playground": ["libs/shared/feat/feat-playground/src/index.ts"],
      "@dvb/feat-publicinfo": ["libs/esc-info-app/feat/feat-publicinfo/src/index.ts"],
      "@dvb/feat-reports": ["libs/shared/feat/feat-reports/src/index.ts"],
      "@dvb/feat-search-popup": ["libs/shared/feat/feat-search-popup/src/index.ts"],
      "@dvb/feat-shared": ["libs/shared/feat/feat-shared/src/index.ts"],
      "@dvb/feat-shared-aufgaben": ["libs/shared/feat/feat-shared-aufgaben/src/index.ts"],
      "@dvb/feat-shared-impfen": ["libs/shared/feat/feat-shared-impfen/src/index.ts"],
      "@dvb/feat-stammdaten": ["libs/esc-app/feat/feat-stammdaten/src/index.ts"],
      "@dvb/feat-anonymer-anlass": ["libs/esc-app/feat/anonymer-anlass/src/index.ts"],
      "@dvb/feat-system": ["libs/esc-app/feat/feat-system/src/index.ts"],
      "@dvb/feat-tenant": ["libs/shared/feat/feat-tenant/src/index.ts"],
      "@dvb/feat-translated-strings": ["libs/shared/feat/feat-translated-strings/src/index.ts"],
