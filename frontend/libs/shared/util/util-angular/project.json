{
  "name": "angular",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/util/util-angular/src",
  "prefix": "util",
  "projectType": "library",
  "tags": [
    "type:util",
    "scope:shared"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "options": {
        "project": "libs/shared/util/util-angular/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/shared/util/util-angular/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/shared/util/util-angular/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/shared/util/util-angular/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
