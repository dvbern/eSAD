{
  "name": "viz",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/ui/viz/src",
  "prefix": "svui",
  "projectType": "library",
  "tags": ["type:ui", "scope:shared"],
  "generators": {
    "@nx/angular:component": {
      "skipImport": true
    },
    "@nx/angular:directive": {
      "skipImport": true
    }
  },
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/shared/ui/viz/ng-package.json",
        "tsConfig": "libs/shared/ui/viz/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/shared/ui/viz/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/shared/ui/viz/jest.config.ts",
        "tsConfig": "libs/shared/ui/viz/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
