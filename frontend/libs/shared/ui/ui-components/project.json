{
  "name": "components",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/ui/ui-components/src",
  "prefix": "svui",
  "projectType": "library",
  "tags": ["type:ui", "scope:shared"],
  "generators": {
    "@nx/angular:component": {
      "skipImport": true
    },
    "@nx/angular:directive": {
      "skipImport": true
    }
  },
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/shared/ui/ui-components/ng-package.json",
        "tsConfig": "libs/shared/ui/ui-components/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/shared/ui/ui-components/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
