{
  "name": "components",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/ui/ui-components/src",
  "prefix": "svui",
  "projectType": "library",
  "tags": [
    "type:ui",
    "scope:shared"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "options": {
        "project": "libs/shared/ui/ui-components/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/shared/ui/ui-components/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/shared/ui/ui-components/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/shared/ui/ui-components/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  },
  "generators": {
    "@nx/angular:component": {
      "skipImport": true
    },
    "@nx/angular:directive": {
      "skipImport": true
    }
  }
}
