<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet author="junie" id="0078-anlass-titel-nullable-1">
    <dropNotNullConstraint columnName="titel" tableName="anlass" columnDataType="VARCHAR(255)"/>
  </changeSet>

  <changeSet author="junie" id="0078-anlass-titel-nullable-2">
    <addColumn tableName="tenantsetting">
      <column name="anlasstitlerequiredfeature" type="VARCHAR(30)"/>
    </addColumn>
  </changeSet>

  <changeSet author="junie" id="0078-anlass-titel-nullable-3">
    <sql>
      UPDATE tenantsetting
      SET anlasstitlerequiredfeature = 'DISABLED'
      WHERE anlasstitlerequiredfeature IS NULL;
    </sql>
  </changeSet>

  <changeSet author="junie" id="0078-anlass-titel-nullable-4">
    <addNotNullConstraint tableName="tenantsetting" columnName="anlasstitlerequiredfeature"/>
  </changeSet>

  <changeSet author="junie" id="0078-anlass-titel-nullable-5">
    <addColumn tableName="tenantsetting_aud">
      <column name="anlasstitlerequiredfeature" type="VARCHAR(30)"/>
    </addColumn>
  </changeSet>

</databaseChangeLog>
