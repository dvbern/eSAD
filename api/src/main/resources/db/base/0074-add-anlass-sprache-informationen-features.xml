<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet author="gema (generated)" id="0074-add-anlass-sprache-informationen-features-1">
    <addColumn tableName="tenantsetting">
      <column name="anlasssprachespaltefeature" type="VARCHAR(30)"/>
      <column name="anlasssprachezusammenfassungfeature" type="VARCHAR(30)"/>
      <column name="anlassinformationenfeature" type="VARCHAR(30)"/>
    </addColumn>
  </changeSet>

  <changeSet author="gema (generated)" id="0074-add-anlass-sprache-informationen-features-2">
    <sql>
      UPDATE tenantsetting
      SET anlasssprachespaltefeature = 'ENABLED'
      WHERE anlasssprachespaltefeature IS NULL;

      UPDATE tenantsetting
      SET anlasssprachezusammenfassungfeature = 'ENABLED'
      WHERE anlasssprachezusammenfassungfeature IS NULL;

      UPDATE tenantsetting
      SET anlassinformationenfeature = 'ENABLED'
      WHERE anlassinformationenfeature IS NULL;
    </sql>
  </changeSet>

  <changeSet author="gema (generated)" id="0074-add-anlass-sprache-informationen-features-3">
    <addNotNullConstraint tableName="tenantsetting" columnName="anlasssprachespaltefeature"/>
    <addNotNullConstraint tableName="tenantsetting" columnName="anlasssprachezusammenfassungfeature"/>
    <addNotNullConstraint tableName="tenantsetting" columnName="anlassinformationenfeature"/>
  </changeSet>

  <changeSet author="gema (generated)" id="0074-add-anlass-sprache-informationen-features-4">
    <addColumn tableName="tenantsetting_aud">
      <column name="anlasssprachespaltefeature" type="VARCHAR(30)"/>
      <column name="anlasssprachezusammenfassungfeature" type="VARCHAR(30)"/>
      <column name="anlassinformationenfeature" type="VARCHAR(30)"/>
    </addColumn>
  </changeSet>

</databaseChangeLog>
