<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet author="junie" id="0079-tenant-settings-login-methods-1">
    <addColumn tableName="tenantsetting">
      <column name="loginmethods" type="VARCHAR(2000)"/>
    </addColumn>
  </changeSet>

  <changeSet author="junie" id="0079-tenant-settings-login-methods-2">
    <sql>
      UPDATE tenantsetting SET loginmethods = 'PASSWORD,DVBERN_HEMED_ENTRA' WHERE loginmethods IS NULL;
    </sql>
  </changeSet>

  <changeSet author="junie" id="0079-tenant-settings-login-methods-3">
    <addNotNullConstraint tableName="tenantsetting" columnName="loginmethods"/>
  </changeSet>

  <changeSet author="junie" id="0079-tenant-settings-login-methods-4">
    <addColumn tableName="tenantsetting_aud">
      <column name="loginmethods" type="VARCHAR(2000)"/>
    </addColumn>
  </changeSet>
</databaseChangeLog>
