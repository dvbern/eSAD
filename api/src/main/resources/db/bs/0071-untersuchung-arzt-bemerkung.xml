  <changeSet author="hefr" id="1755769925401-15">
    <sql>
      -- Pro UntersuchungArzt, wo es eine Bemerkung hat, ein UntersuchungArztBemerkung anlegen
      INSERT INTO untersuchungarztbemerkung (
        id, timestamperstellt, timestampmutiert, usererstellt, usermutiert, version, tenant, bemerkungen
      ) SELECT
          id, timestamperstellt, timestampmutiert, usererstellt, usermutiert, version, tenant, bemerkungen
      FROM untersuchungarzt
      WHERE bemerkungen IS NOT NULL AND bemerkungen != '';
      -- Verlinkung auf der Untersuchung aktualisieren
      UPDATE untersuchung SET untersuchungarztbemerkung_id = (
        SELECT b.id FROM untersuchungarztbemerkung b WHERE b.id = untersuchungarzt_id
      )
      WHERE untersuchungarztbemerkung_id IS NULL;
    </sql>
  </changeSet>
