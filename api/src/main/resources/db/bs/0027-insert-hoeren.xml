  <changeSet author="hefr" id="1744796911630-5a">
    <sql>
      update anlassconfig set hoerenzusaetzlicheangaben = 'NOT_VISIBLE'
      where anlasstyp in ('IMPFAKTION', 'IMPFSPRECHSTUNDE', 'IMPFTERMIN');

      update anlassconfig set hoerenzusaetzlicheangaben = 'REQUIRED'
      where anlasstyp not in ('IMPFAKTION', 'IMPFSPRECHSTUNDE', 'IMPFTERMIN');

      update anlassconfig set hoerenbemerkungen = 'OPTIONAL' 
      where anlasstyp not in ('IMPFAKTION', 'IMPFSPRECHSTUNDE', 'IMPFTERMIN');
