    </addColumn>
  </changeSet>
  <changeSet author="hora" id="1750064037560-5">
    <sql>
      UPDATE schule
      SET schuleaktivstatus = 'INAKTIV'
      WHERE aktivinexternalsystem = false;
      UPDATE schule
      SET schuleaktivstatus = 'AKTIV'
      WHERE aktivinexternalsystem = true OR aktivinexternalsystem IS NULL;
    </sql>
  </changeSet>
  <changeSet author="hora" id="1750064037560-6">
    <sql>
      UPDATE klasse
      SET klasseaktivstatus = 'INAKTIV'
      WHERE aktivinexternalsystem = false;
      UPDATE klasse
      SET klasseaktivstatus = 'AKTIV'
      WHERE aktivinexternalsystem = true OR aktivinexternalsystem IS NULL;
    </sql>
  </changeSet>
  <changeSet author="hora" id="1750064037560-7">
    <addNotNullConstraint tableName="schule" columnName="schuleaktivstatus"/>
  </changeSet>
  <changeSet author="hora" id="1750064037560-8">
