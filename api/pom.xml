    <build>
        <plugins>
            <!-- <editor-fold desc="quarkus-maven-plugin" defaultstate="collapsed"> -->
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- </editor-fold> -->

            <!-- <editor-fold desc="maven-compiler-plugin" defaultstate="collapsed"> -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <showWarnings>true</showWarnings>
                    <compilerArgs>
                        <arg>-parameters</arg>
                        <arg>-Xlint:all</arg>
                        <arg>-Xlint:-processing</arg>
                        <!-- helps when using maven + IntelliJ in parallel: -->
                        <!-- prevents compiler warning if overwriting IntelliJ-generated files from Annotaton-Processor -->
                        <arg>-implicit:class</arg>
                        <arg>-Amapstruct.suppressGeneratorTimestamp=true</arg>
                        <arg>-Amapstruct.suppressGeneratorVersionInfoComment=true</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>io.github.openfeign.querydsl</groupId>
                            <artifactId>querydsl-apt</artifactId>
                            <classifier>jpa</classifier>
                            <version>${querydsl.version}</version>
                        </path>
                        <dependency>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </dependency>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- </editor-fold> -->

            <!-- <editor-fold desc="maven-surefire-plugin" defaultstate="collapsed"> -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
     <argLine>@{argLine}</argLine>
                </configuration>
            </plugin>
            <!-- </editor-fold> -->

            <!-- <editor-fold desc="maven-failsafe-plugin" defaultstate="collapsed"> -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <systemPropertyVariables>
                                <native.image.path>${project.build.directory}/${project.build.finalName}-runner</native.image.path>
                                <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                                <maven.home>${maven.home}</maven.home>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
    <configuration>
     <argLine>@{argLine}</argLine>
    </configuration>
            </plugin>
            <!-- </editor-fold> -->

            <!-- <editor-fold desc="jacoco-maven-plugin" defaultstate="collapsed"> -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>default-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <exclClassLoaders>*QuarkusClassLoader</exclClassLoaders>
                            <destFile>${project.build.directory}/jacoco-quarkus.exec</destFile>
                            <append>true</append>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- </editor-fold> -->

            <!-- <editor-fold desc="maven-enforcer-plugin" defaultstate="collapsed"> -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <configuration>
                            <!-- these rules extend rules defined in the parent pom! -->
                            <rules>
                                <banDistributionManagement/>
                                <banDuplicatePomDependencyVersions/>
                                <reactorModuleConvergence/>
                                <requireNoRepositories/>
                                <dependencyConvergence/>
                                <requireUpperBoundDeps>
                                    <excludes>
                                        <!-- Quarkus does some fancy stuff with dependencies which seems to break this enforcer rule :( -->
                                        <!-- But these versions are managed by Quarkus anyway -->
                                        <exclude>io.smallrye.common:smallrye-common-expression</exclude>
                                        <exclude>io.smallrye.common:smallrye-common-ref</exclude>
                                        <exclude>io.smallrye.common:smallrye-common-classloader</exclude>
                                        <exclude>io.smallrye.common:smallrye-common-annotation</exclude>
                                        <exclude>io.smallrye.common:smallrye-common-os</exclude>
                                        <exclude>io.smallrye.common:smallrye-common-net</exclude>
                                        <exclude>io.smallrye.common:smallrye-common-cpu</exclude>
                                        <exclude>io.smallrye.common:smallrye-common-constraint</exclude>
                                        <exclude>org.wildfly.common:wildfly-common</exclude>
                                        <exclude>io.smallrye.reactive:mutiny</exclude>
                                        <exclude>jakarta.el:jakarta.el-api</exclude>
                                        <exclude>org.eclipse.microprofile.config:microprofile-config-api</exclude>
                                        <exclude>com.google.guava:failureaccess</exclude>
                                        <exclude>com.google.j2objc:j2objc-annotations</exclude>
                                        <!-- We (unfortunately) need to manage these manually anyway, so we exclude them from this -->
                                        <exclude>org.apache.poi:poi</exclude>
                                        <exclude>org.apache.poi:poi-scratchpad</exclude>
                                        <exclude>com.healthmarketscience.jackcess:jackcess</exclude>
                                        <!-- quarkus-bom 3.33.2.1 manages the whole jackson family at 2.21.2.
                                             Transitive POMs declare 2.21.4; patch-level, platform-tested.
                                             Re-evaluate on Quarkus upgrade. -->
                                        <exclude>com.fasterxml.jackson.core:jackson-core</exclude>
                                    </excludes>
                                </requireUpperBoundDeps>
                                <bannedDependencies>
                                    <excludes>
                                        <!-- Logging APIs provided by quarkus             -->
                                        <!-- see https://quarkus.io/guides/logging        -->
                                        <!-- Use slf4j bridges in test scopes if required -->
                                        <exclude>commons-logging:commons-logging</exclude>
                                        <exclude>org.apache.logging.log4j:log4j-core:*:*:compile</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- </editor-fold> -->

            <!-- <editor-fold desc="liquibase-maven-plugin: diff" defaultstate="collapsed"> -->
            <plugin>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-maven-plugin</artifactId>
                <version>${liquibase-diff.liquibase.version}</version>
                <configuration>
                    <changeLogFile>src/main/resources/db/changeLog_bs.xml</changeLogFile>
                    <diffChangeLogFile>src/main/resources/db/XXXX-diffchange_all_tenants.xml</diffChangeLogFile>
                    <outputChangeLogFile>src/main/resources/db/XXXX-genchange_all_tenants.xml</outputChangeLogFile>

                    <!-- old/reference state -->
                    <driver>org.postgresql.Driver</driver>
                    <propertyFile>../developer-local-settings/config/liquibase/liquibase_bs.properties</propertyFile>

                    <!-- target state -->
                    <referenceUrl>hibernate:ejb3:LiquibasePU</referenceUrl>
                    
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>io.quarkus</groupId>
                        <artifactId>quarkus-hibernate-orm</artifactId>
                        <version>${quarkus.platform.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.liquibase</groupId>
                        <artifactId>liquibase-core</artifactId>
                        <version>${liquibase-diff.liquibase.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.liquibase.ext</groupId>
                        <artifactId>liquibase-hibernate6</artifactId>
                        <version>${liquibase-diff.liquibase.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>io.quarkus</groupId>
                        <artifactId>quarkus-jdbc-postgresql</artifactId>
                        <version>${quarkus.platform.version}</version>
                    </dependency>
                    <dependency>
                        <!-- also works without this dep but produces ugly error messages -->
                        <groupId>org.springframework</groupId>
                        <artifactId>spring-core</artifactId>
                        <version>${liquibase-diff.spring.version}</version>
                    </dependency>
                    <dependency>
                        <!-- also works without this dep but produces ugly error messages -->
                        <groupId>org.springframework</groupId>
                        <artifactId>spring-beans</artifactId>
                        <version>${liquibase-diff.spring.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <!-- </editor-fold> -->
        </plugins>
    </build>

    <profiles>
        <!-- <editor-fold desc="liquibase-diff" defaultstate="collapsed"> -->
        <profile>
            <id>liquibase-diff</id>
            <build>
                <defaultGoal>compile liquibase:diff</defaultGoal>
            </build>
            
        </profile>
        <!-- </editor-fold> -->
        <!-- <editor-fold desc="native" defaultstate="collapsed"> -->
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
            </properties>
        </profile>
        <!-- </editor-fold> -->

        <!-- <editor-fold desc="rest-assured-client" defaultstate="collapsed"> -->
        <profile>
            <id>rest-assured-client</id>
            <activation>
                <!--                by default only run generation if tests are not skipped-->
                <property>
                    <name>skipTests</name>
                    <value>!true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-clean-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <id>clean-rest-assured</id>

                                <phase>clean</phase>
                                <goals>
                                    <goal>clean</goal>
                                </goals>
                                <configuration>
                                    <filesets>
                                        <fileset>
                                            <directory>${basedir}/src/test/java/ch/dvbern/oss/hemed/esc/generated/restassured</directory>
                                        </fileset>
                                    </filesets>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.openapitools</groupId>
                        <artifactId>openapi-generator-maven-plugin</artifactId>
                        <version>7.12.0</version>
                        <executions>
                            <!--  This generates the rest assured client for testing -->
                            <execution>
                                <id>generate-rest-assured-test-client</id>
                                <!-- das benoetigte openapi.yaml wird beim starten des quarkus generiert -->
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                                <configuration>
                                    <inputSpec>${contract.path}</inputSpec>
                                    <output>${rest-assured.temp.gen.dir}</output>
                                    <generatorName>java</generatorName>
                                    <library>rest-assured</library>
                                    <groupId>${project.groupId}</groupId>
                                    <artifactId>${project.artifactId}-test-client</artifactId>
                                    <artifactVersion>${project.version}</artifactVersion>
                                    <skipOverwrite>false</skipOverwrite>
                                    <skipValidateSpec>true</skipValidateSpec>
                                    <generateModelTests>false</generateModelTests>
                                    <generateApiTests>false</generateApiTests>
                                    <apiNameSuffix>ApiSpec</apiNameSuffix>
                                    <modelNameSuffix>Spec</modelNameSuffix>
                                    <configOptions>
                                        <url>http://localhost:8080</url>
                                        <modelPackage>${rest-assured.generation.package}.dto</modelPackage>
                                        <invokerPackage>${rest-assured.generation.package}</invokerPackage>
                                        <apiPackage>${rest-assured.generation.package}.api</apiPackage>
                                        <useJakartaEe>true</useJakartaEe>
                                        <serializationLibrary>jackson</serializationLibrary>
                                        <containerDefaultToNull>true</containerDefaultToNull>
                                        <hideGenerationTimestamp>true</hideGenerationTimestamp>
                                        <headerVars>
                                            <hideVersion>true</hideVersion>
                                        </headerVars>
                                        <additionalModelTypeAnnotations>@lombok.AllArgsConstructor</additionalModelTypeAnnotations>
                                    </configOptions>
                                    <typeMappings>
                                        <typeMapping>OffsetDateTime=java.time.LocalDateTime</typeMapping>
                                        FileUpload=org.jboss.resteasy.reactive.multipart.FileUpload
                                    </typeMappings>
                                </configuration>
                            </execution>
                        </executions>

                    </plugin>

                    <!--copy the rest assured files into the quarkus directory-->
                    <plugin>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.0.2</version>
                        <executions>
                            <!--  This copies only the relevant java classed of the generated rest-assured client -->
                            <execution>
                                <id>copy-openapi-rest-assured-classes-to-project</id>
                                <!-- das benoetigte openapi.yaml wird beim starten des quarkus generiert -->
                                <phase>process-test-resources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${basedir}/src/test/java</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${rest-assured.temp.gen.dir}/src/main/java</directory>
                                            <includes>
                                                <include>**/*</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>

                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- </editor-fold> -->
        <!-- <editor-fold desc="native" defaultstate="collapsed"> -->
    </profiles>
</project>
