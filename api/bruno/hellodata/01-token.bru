meta {
  name: 01 Get token (client_credentials)
  type: http
  seq: 1
}

post {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: {{clientId}}
  client_secret: {{clientSecret}}
}

script:post-response {
  // Store the token for the following requests (runtime var, not persisted)
  bru.setVar("accessToken", res.body.access_token);
}

tests {
  test("token received", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.access_token).to.be.a("string");
  });
}

docs {
  Service account of the HelloData export in realm `be`.

  The client only needs the role `HELLODATA_EXPORT_LESEN` (FachRolle
  `HELLODATA_SERVICE`). No human Benutzer gets this role.

  `clientSecret` is a secret variable and is deliberately not checked in -
  set it in Bruno under Environment > local-be.
}
