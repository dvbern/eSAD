# Used for request validation, URL generation, ...
ESC_API_DEPLOYMENT_PUBLIC_URL=https://local-esc-bs.localhost:4443

ESC_API_DEV_DB_USERNAME=CHANGEME
ESC_API_DEV_DB_PASSWORD=CHANGEME
ESC_API_DEV_DB=esc
ESC_API_DEV_DB_PORT=5432
ESC_API_TEST_DB_PORT=5433

_DEV_APP_TENANT_OVERRIDE=BS
_DEV_ESC_TENANT_OVERRIDE=BS

# KC REALM IMPORT Settings

KC_ENV=local
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGEME
