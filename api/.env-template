KC_HTTPS_CERTIFICATE_KEY_FILE=/opt/certs/local-esc-bs.localhost.key
KC_HOSTNAME=https://local-esc-bs.localhost:8989
KC_HOSTNAME_BACKCHANNEL_DYNAMIC="true"
QUARKUS_HTTP_ACCESS_LOG_ENABLED="true"

CLIENT_ESC_AUTH_PROXY_WEB_ROOT_URL=https://local-esc-bs.localhost:4443
# Secret for client above will be passed through OAUTH2_PROXY_CLIENT_SECRET

REALM_IDP_VACME_ISSUER=https://vacme-dev.dvbern.ch/auth/realms/vacme-web
REALM_IDP_VACME_ALIAS=vacme-dev

#Go get this from https://vacme-dev.dvbern.ch/auth/admin/master/console/#/realms/vacme-web/clients/801aff9e-545b-4d3c-959d-393e9a47a57e/credentials
REALM_IDP_VACME_SECRET=CHANGEME

# angular oidc client (should not be needed anymore but is still in the realm)
CLIENT_ESC_WEB_ROOT_URL=https://local-esc-bs.localhost:4200

# Keycloak Server that will be used to validate passed tokens
