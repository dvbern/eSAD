OAUTH2_PROXY_CLIENT_SECRET=TODO CHANGEME get from keycloak or just set something in the form of 'AFdcf6mt0nKxhbat5Mo4D9LCyolUHwDP'

# S3 Settings
#S3 access key
ESC_S3_ACCESS_KEY=test-key
ESC_S3_ACCESS_SECRET=test-secret
ESC_S3_ENCRYPTION_KEY_BS=TODO CHANGEME GENERATE SECRET or delete the line (see ch.dvbern.oss.hemed.esc.api.shared.fileio.s3.S3EncryptionKeyGeneratorTest.generateS3EncryptionKey)

# FEATURES
APP_ALLOW_DB_RESET=FALSE
APP_ALLOW_TIMETRAVEL=TRUE

# LOGGING
